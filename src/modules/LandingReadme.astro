---
import Code from "astro/components/Code.astro"

import AstroLogo from "../assets/astro-icon.svg?raw"
import FlowbiteLogo from "../assets/flowbite-logo.svg?raw"

import * as readMe from "../../README.md"
import { SITE_TITLE } from "@astro/constants.js"
---

<div
  class="mb-20 bg-gradient-to-r from-slate-100 to-slate-200 p-4 text-slate-800 shadow-xl shadow-slate-200 lg:p-16 dark:from-slate-900 dark:to-slate-800 dark:text-slate-100 dark:shadow-slate-900"
>
  <header
    class="mt-16 flex w-full flex-col flex-wrap items-center justify-center p-8"
  >
    <div class="flex w-full justify-center">
      <div
        set:html={AstroLogo}
        class="svg-inline h-16 w-16 text-violet-700 dark:text-violet-100"
      />
    </div>

    <div class="format dark:format-invert lg:format-lg mt-32">
      <p
        class="text-4xl leading-tight text-slate-600 lg:text-8xl dark:text-slate-200"
      >
        Hello <a
          rel="noopener nofollow"
          href="https://astro.build"
          class="bg-gradient-to-br from-pink-400 to-violet-800 bg-clip-text font-bold text-transparent no-underline dark:from-pink-300 dark:to-violet-700"
          >Astro</a
        >…
        <br />meet <a
          rel="noopener nofollow"
          href="https://flowbite.com"
          class="font-bold text-blue-600 no-underline dark:text-blue-500"
          >Flowbite</a
        >!
      </p>

      <div class="flex w-full justify-center">
        <Confettis>
          <button
            type="button"
            class="mr-2 mb-2 rounded-lg border border-blue-700 px-5 py-2.5 text-center text-sm font-medium text-blue-800 hover:bg-blue-700 hover:text-white focus:ring-4 focus:ring-blue-300 focus:outline-none dark:border-blue-500 dark:text-blue-100 dark:hover:bg-blue-600 dark:hover:text-white dark:focus:ring-blue-800"
            >Click me!</button
          >
        </Confettis>
      </div>
    </div>

    <div class="my-16 flex w-full justify-center">
      <div set:html={FlowbiteLogo} class="svg-inline h-16 w-16" />
    </div>
  </header>

  <section class="flex w-full justify-center pb-24">
    <div class="format dark:format-invert w-full">
      <Code
        lang={"powershell" /* Looks cool */}
        code={`git clone \\
https://github.com/themesberg/flowbite-astro-admin-dashboard.git`}
      />
    </div>
  </section>

  <article class="flex justify-center pt-32 pb-32">
    <div class="readme format dark:format-invert lg:format-lg w-full">
      <h1 class="text-center">
        <!-- {readMe.getHeadings()[0].text} -->
        {SITE_TITLE}
      </h1>
      <readMe.Content />
    </div>
  </article>
</div>

<style>
  /* Override in Markdown H1 title */
  .readme :global(h1:nth-of-type(2)) {
    display: none;
  }

  .svg-inline :global(svg) {
    height: 100%;
    width: 100%;
  }
</style>
