---
import { getCollection, type CollectionEntry } from 'astro:content'
import LayoutSidebar from '../../app/LayoutSidebar.astro'
import {ascending} from "d3-array"

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  return docs.map((doc) => ({
    params: { id: doc.id },
    props: { doc }
  }))
}

type Props = {
  doc: CollectionEntry<'docs'>
}

const { doc } = Astro.props
// const { Content, headings } = await render(doc)
// const { description, title } = doc.data

const docs = await getCollection('docs')
docs.sort((a,b) => ascending(a.data.sectionNumber, b.data.sectionNumber))

---

<LayoutSidebar>
  <div class="grid grid-cols-3 gap-4">

  {
  docs.map(d => (<a href={"/docs/" + d.id}  class="block max-w-sm p-6 bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">

<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white"><span class="section-number">{d.data.sectionNumber}</span>{d.data.title}</h5>
<p class="font-normal text-gray-700 dark:text-gray-400">Here are the biggest enterprise technology acquisitions of 2021 so far, in reverse chronological order.</p>
</a>
))}
</div>
  

</LayoutSidebar>