---
import { type CollectionEntry, getCollection } from "astro:content";
import LayoutSidebar from "@astro/LayoutSidebar.astro";
import { ascending } from "d3";
import ContentPage from "@components/ContentPage.astro";

const sections = await getCollection("sections");
sections.sort(
  (a: CollectionEntry<"sections">, b: CollectionEntry<"sections">) =>
    ascending(a.data.sectionNumber, b.data.sectionNumber),
);
---

<LayoutSidebar>
  {sections.map((section) => <ContentPage {section} />)}
</LayoutSidebar>
