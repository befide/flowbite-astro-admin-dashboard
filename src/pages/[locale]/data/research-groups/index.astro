import LayoutSidebar from "@astro/LayoutSidebar.astro";
import type { GetStaticPaths } from "astro";
import CommunityTreeExplorer from "@components/dc-explorer/CommunityTreeExplorer.astro";

export const getStaticPaths = (async () => {
  const locales = ["en", "de"];

  return locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}) satisfies GetStaticPaths;
