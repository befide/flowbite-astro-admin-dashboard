import LayoutSidebar from "@astro/LayoutSidebar.astro"
import type { GetStaticPaths } from "astro"
import CoursesExplorer from "@components/dc-explorer/CoursesExplorer.astro"

export const getStaticPaths = (async () => {
  const locales = ["en", "de"]

  return locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}) satisfies GetStaticPaths
---

<LayoutSidebar>
  <CoursesExplorer />
</LayoutSidebar>
