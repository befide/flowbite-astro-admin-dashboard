---
import LayoutSidebar from "../../../astro/LayoutSidebar.astro";
import type {GetStaticPaths} from "astro";
import OrganizationsExplorer from "../../../astro/components/dc-explorer/OrganizationsExplorer.astro";

export const getStaticPaths = (async () => {
  const locales = ["en", "de"]

  return locales.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}) satisfies GetStaticPaths


---

<LayoutSidebar >
  <OrganizationsExplorer />
</LayoutSidebar>

