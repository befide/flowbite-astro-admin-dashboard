---
import { getLangFromUrl, useTranslations } from '@astro/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

import DCExplorerCount from "@components/dc-explorer/components/DCExplorerCount.astro"
import DCExplorerBarChart from "@components/dc-explorer/components/DCExplorerBarChart.astro"
import DCExplorerRowChart from "@components/dc-explorer/components/DCExplorerRowChart.astro"
import DCExplorerTable from "@components/dc-explorer/components/DCExplorerTable.astro"
import DCExplorer from "@components/dc-explorer/components/DCExplorer.astro"
---

<DCExplorer collection="organizations">
  <div class="dc-explorer__filters">
    <DCExplorerCount collection="organizations" dimension="count" />
    <DCExplorerRowChart
      collection="organizations"
      dimension="instanceOfs__term"
      title="Category"
      dimensionIsArray={true}
    />
    <DCExplorerRowChart
      collection="organizations"
      dimension="location__country"
      title="Country"
    />

    <DCExplorerRowChart
      collection="organizations"
      dimension="with_userFacilities"
      title={t("dc-explorer.tiles.title.with_userFacilities")}
    />

    <DCExplorerRowChart
      collection="organizations"
      dimension="with_facilities"
      title={t("dc-explorer.tiles.title.with_facilities")}
    />
    <DCExplorerRowChart
      collection="organizations"
      dimension="with_theses"
      title={t("dc-explorer.tiles.title.with_theses")}
    />
    <DCExplorerRowChart
      collection="organizations"
      dimension="with_teachingEvents"
      title={t("dc-explorer.tiles.title.with_teachingEvents")}
    />
    <DCExplorerBarChart
      collection="organizations"
      dimension="people_count"
      title={t("dc-explorer.tiles.title.people_count")}
    />
<DCExplorerBarChart
      collection="organizations"
      dimension="theses_count"
      title={t("dc-explorer.tiles.title.theses_count")}
    />

    <!-- </details> -->
  </div>
  <div class="dc-explorer__items">
    <DCExplorerTable collection="organizations" dimension="id" />
  </div>
  <div class="dc-explorer__item">
    <!-- <DCExplorerItemCard collection="organizations" dimension="id" /> -->
  </div>
</DCExplorer>
