---
import {
  getLangFromUrl,
  useTranslations,
} from "@astro/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
import DCExplorerCount from "@components/dc-explorer/components/DCExplorerCount.astro"
import DCExplorerRowChart from "@components/dc-explorer/components/DCExplorerRowChart.astro"
import DCExplorer from "@components/dc-explorer/components/DCExplorer.astro"
import DCExplorerTreeDataTable from "@components/dc-explorer/components/DCExplorerTreeDataTable.astro"
---

<DCExplorer collection="facilities">
  <div class="dc-explorer__filters">
    <DCExplorerCount
      collection="facilities"
      dimension="count"
    />

    <DCExplorerRowChart
      collection="facilities"
      dimension="host__label_short"
      title="host"
    />
    <DCExplorerRowChart
      collection="facilities"
      dimension="instanceOf__term"
      title="instanceOf"
    />
    <DCExplorerRowChart
      collection="facilities"
      dimension="currentStatus__term"
      title="lifeCycle"
    />
    <DCExplorerRowChart
      collection="facilities"
      dimension="primaryBeamParticles"
      title={t(
        "dc-explorer.tiles.title.primaryBeamParticles",
      )}
      dimensionIsArray={true}
    />
    <DCExplorerRowChart
      collection="facilities"
      dimension="secondaryBeamParticles"
      title={t(
        "dc-explorer.tiles.title.secondaryBeamParticles",
      )}
      dimensionIsArray={true}
    />
  </div>
  <div class="dc-explorer__items">
    <DCExplorerTreeDataTable
      collection="facilities"
      dimension="id"
    />
  </div>
</DCExplorer>
