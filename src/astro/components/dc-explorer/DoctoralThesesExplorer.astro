---
import DCExplorerCount from "@components/dc-explorer/components/DCExplorerCount.astro"
import DCExplorerRowChart from "@components/dc-explorer/components/DCExplorerRowChart.astro"
import DCExplorerBarChart from "@components/dc-explorer/components/DCExplorerBarChart .astro"
import DCExplorerTable from "@components/dc-explorer/components/DCExplorerTable.astro"
import DCExplorer from "@components/dc-explorer/components/DCExplorer.astro"
---

<DCExplorer collection="theses">
  <div class="dc-explorer__filters">
    <DCExplorerCount collection="theses" dimension="count" />
    <DCExplorerBarChart
      collection="theses"
      dimension="year"
      title={Astro.locals.t("dc-explorer.tiles.title.year")}
    />
    <DCExplorerRowChart
      collection="theses"
      dimension="degreeTitle"
      title={Astro.locals.t("dc-explorer.tiles.title.degree")}
    />
    <DCExplorerRowChart
      collection="theses"
      dimension="gender"
      title={Astro.locals.t("dc-explorer.tiles.title.gender")}
      accessorPath="author.gender"
    />
    <DCExplorerRowChart
      collection="theses"
      dimension="university__label_short"
      title={Astro.locals.t("dc-explorer.tiles.title.university")}
    />
    <DCExplorerRowChart
      collection="theses"
      dimension="facilities__label_short"
      title={Astro.locals.t("dc-explorer.tiles.title.facilities")}
      dimensionIsArray={true}
    />
    <DCExplorerRowChart
      collection="theses"
      dimension="affiliations__label_short"
      title={Astro.locals.t("dc-explorer.tiles.title.facilities")}
      dimensionIsArray={true}
    />

    <DCExplorerRowChart
      collection="theses"
      dimension="language"
      title={Astro.locals.t("dc-explorer.tiles.title.language")}
    />
    <!-- </details> -->
  </div>
  <div class="dc-explorer__items">
    <DCExplorerTable collection="theses" dimension="id" />
  </div>
</DCExplorer>
