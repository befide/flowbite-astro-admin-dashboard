---
import DCExplorerCount from "@components/dc-explorer/components/DCExplorerCount.astro"
import DCExplorerRowChart from "@components/dc-explorer/components/DCExplorerRowChart.astro"
import DCExplorer from "@components/dc-explorer/components/DCExplorer.astro"
import DCExplorerTreeDataTable from "@components/dc-explorer/components/DCExplorerTreeDataTable.astro"
---

<DCExplorer collection="community">
  <div class="dc-explorer__filters">
    <DCExplorerCount collection="taxonomy" dimension="count" />

    <DCExplorerRowChart
      collection="community"
      dimension="instanceOfs__term"
      isArray={true}
      title="type"
    />
  </div>
  <div class="dc-explorer__items">
    <DCExplorerTreeDataTable collection="taxonomy" dimension="id" />
  </div>
  <div class="dc-explorer__items">
    <DCExplorerTreeDataTable collection="taxonomy" dimension="id" />
  </div>
</DCExplorer>
