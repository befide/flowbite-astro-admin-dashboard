---
interface Entry {
  name: string
  required: boolean
  description: string
  type: string
}

interface Props {
  entries: Entry[]
  ident?: boolean
}

const { entries, ident = true } = Astro.props
---

<table class="grid-table schema-table" data-ident={ident}>
  <thead
    ><tr
      ><th class="name">Property name</th>
      <th class="required">Required</th>
      <th class="type">Type / Description</th>
    </tr></thead
  ><tbody>
    {
      entries.map(({ name, required, description, type }) => (
        <tr>
          <td class="name" data-depth={ident && name.split(".").length}>
            <strong>
              <code dir="auto">{ident ? name.split(".").pop() : name}</code>
            </strong>{" "}
          </td>
          <td class="required">
            {required ? (
              <span class="me-2 inline-flex h-2 w-2 items-center justify-center rounded-full bg-gray-100 text-sm font-semibold text-gray-800 dark:bg-gray-700 dark:text-gray-300">
                <svg
                  class="h-2.5 w-2.5"
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 16 12"
                >
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M1 5.917 5.724 10.5 15 1.5"
                  />
                </svg>
                <span class="sr-only">Icon description</span>
              </span>
            ) : (
              ""
            )}
          </td>
          <td class="type-and-description">
            <div class="type">
              <code dir="auto">{type}</code>
            </div>
            <div class="description">{description}</div>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  table.schema-table {
    table-layout: fixed;
    width: 100%;
  }

  code {
    white-space: wrap;
    font-size: var(--text-xs);
    line-height: 1rem;
  }
  .name {
    height: auto;
    width: 15em;
    overflow: hidden;
  }

  .required {
    width: 5em;
    text-align: center;
  }
  .type-and-description {
    width: 50%;
  }
  .name[data-depth="1"] {
    padding-left: 0;
  }
  .name[data-depth="2"] {
    padding-left: 0.5rem;
  }
  .name[data-depth="3"] {
    padding-left: 1rem;
  }
  .name[data-depth="4"] {
    padding-left: 1.5rem;
  }
  .name[data-depth="5"] {
    padding-left: 2rem;
  }


</style>
