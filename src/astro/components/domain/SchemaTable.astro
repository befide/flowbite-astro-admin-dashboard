---
interface Entry {
  name: string
  required: boolean
  description: string
  type: string
}

interface Props {
  entries: Entry[]
  ident?: boolean
}

const { entries, ident = true } = Astro.props
---

<table class="table schema-table not-format" data-ident={ident}>
  <thead
    ><tr
      >
    <th class="name">Property name</th><th class="required">Required</th>


      <th class="type-and-description">Type / Description</th>
    </tr></thead
  ><tbody>
    {
      entries.map(({ name, required, description, type }) => (
        <tr>
          <td class="name" data-depth={ident && name.split(".").length}>
            <strong>
              <code dir="auto">{ident ? name : name}</code>
            </strong>{" "}
          </td>
          <td class="required">
            {required ? (
              <span class="required">required</span>
            ) : (
              <span class="optional">optional</span>
            )}
          </td>
          <td class="type-and-description">
            <div class="type">
              <code dir="auto">{type}</code>
            </div>
            <div class="description">{description}</div>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  table.schema-table {
    table-layout: fixed;
    width: 100%;
  }


  code {
    white-space: wrap;
    font-size: var(--text-xs);
    line-height: 1rem;
  }
  th.name, td.name {

    width: 40%;
    overflow: hidden;
  }
  th.required, td.required {

    width: 10em;

  }

  .required {
    //width: 1rem;
    text-align: center;
  }
  th.type-and-description, td.type-and-description {
    width: 50%;
  }
  .name[data-depth="1"] {
    text-indent: 0;
  }
  .name[data-depth="2"] {
    text-indent: .75rem;
  }
  .name[data-depth="2"] code:before {
    content: ".";
  }
  .name[data-depth="3"] {
    text-indent: 1.5rem;
  }
  .name[data-depth="4"] {
    text-indent: 2.25rem;
  }
  .name[data-depth="5"] {
    text-indent: 3rem;
  }


</style>
