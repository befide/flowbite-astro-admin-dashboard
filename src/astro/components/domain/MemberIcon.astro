---
const { careerLevel, disciplinaryProfession, gender } = Astro.props

const definedClasses = [careerLevel, disciplinaryProfession, gender].filter((d) => d)
---

<span class:list={["member-icon", ...definedClasses]} title={definedClasses.join(",")}
  >{definedClasses.join(",")}</span
>

<style>
  .member-icon {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    overflow: hidden;
    border-top-style: solid;
    border-top-color: #bbbbbb;

    border-radius: 50%;
  }
  .member-icon.engineer {
    border-radius: 0;
  }
  .member-icon.other {
    border-radius: 0;
    transform: rotate(45deg);
  }

  .member-icon,
  .member-icon.nonbinary {
    background-color: #666666;
  }
  .member-icon.female {
    background-color: #b85887;
    border-top-color: #ffc2df;
  }
  .member-icon.male {
    background-color: #2768a4;
    border-top-color: #b1d9ff;
  }
  .member-icon.professor {
    border-top-width: 0;
  }
  .member-icon.seniorResearcher {
    border-top-width: 2px;
  }
  .member-icon.postDoc {
    border-top-width: 4px;
  }
  .member-icon.phdStudent {
    border-top-width: 6px;
  }
  .member-icon.masterStudent {
    border-top-width: 8px;
  }
  .member-icon.bachelorStudent {
    border-top-width: 10px;
  }
</style>
