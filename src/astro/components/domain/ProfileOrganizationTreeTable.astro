---
import fastCartesian from "fast-cartesian"
import MemberIcon from "./MemberIcon.astro"
import { careerLevels, disciplinaryProfessions, genders, Organization } from "../../../lib/domain"
import { flattenTreeNodes, getRoots } from "../../../lib/content.tree"
import { getValue } from "../../../lib/content"
import { OrganizationSchema } from "../../../lib/common"

interface Props {
  organization: Organization
}
let { organization } = Astro.props

const product = fastCartesian([[...careerLevels], [...disciplinaryProfessions], [...genders]])

const organisations = (await organization.getOrganizationList()).map((d) => ({ ...d, parent__id: d.parent__id === "community" ? null : d.parent__id }))
const roots = getRoots<OrganizationSchema>(organisations)

const list = flattenTreeNodes(roots)
---

<section>
  <table class="tree-table">
    <thead>
      <tr>
        <th class="name">Name</th>
        <th class="members">members</th>
        <!--<th>total</th>-->
        {
          careerLevels.map((d) => (
            <th class="number">
              <span>{d}</span>
              <MemberIcon careerLevel={d} />
            </th>
          ))
        }
        {
          disciplinaryProfessions.map((d) => (
            <th class="number">
              <span>{d}</span>
              <MemberIcon disciplinaryProfession={d} />
            </th>
          ))
        }
        {
          genders.map((d) => (
            <th class="number">
              <span>{d}</span>
              <MemberIcon gender={d} />
            </th>
          ))
        }
        <th class="number"><span>members recursive count</span><MemberIcon /></th>
      </tr>
    </thead>
    <tbody>
      {
        list.map((item) => (
          <tr data-depth={item.depth} data-child-index={item.childIndex} data-has-children={item.children.length > 0}>
            <th class="name tree-table__name tree-table__indent">{item.data.label.fullName.en}</th>
            <td class="members">
              {product
                .filter((p) => getValue(item.data.uniquePeopleCount, p.join(".")))
                .map((p) => new Array(getValue(item.data.uniquePeopleCount, p.join("."))).fill(0).map(() => <MemberIcon careerLevel={p[0]} disciplinaryProfession={p[1]} gender={p[2]} />))}
            </td>
            {careerLevels.map((d) => (
              <td class="number">{getValue(item.data.uniquePeopleCountRecursiveSum, d) || "-"}</td>
            ))}

            {disciplinaryProfessions.map((d) => (
              <td class="number">{getValue(item.data.uniquePeopleCountRecursiveSum, d) || "-"}</td>
            ))}

            {genders.map((d) => (
              <td class="number">{getValue(item.data.uniquePeopleCountRecursiveSum, d) || "-"}</td>
            ))}
            <td class="number">
              <strong>{item.data.uniquePeopleCountRecursiveSum?.total}</strong>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<style>
  thead tr:first-child th {
    position: relative;
    height: 5rem;
    vertical-align: bottom;
  }
  thead tr:first-child th span {
    display: block;
    transform-origin: left bottom;
    position: absolute;
    font-weight: 300;

    transform: rotate(45deg) translate(calc(-100% - 1rem), 0rem);
  }
  .tree-table thead th.number,
  .tree-table td.number {
    width: 5ch;
  }

  .tree-table th.members,
  .tree-table td.members {
    width: 20ch;
    text-align: right;
  }
  .tree-table th.name,
  .tree-table td.name {
    width: 40%;
    white-space: break-spaces;
    line-height: 0.75rem;
  }

  tr[data-depth="1"] .tree-table__indent {
    text-indent: 0.25rem;
  }
  tr[data-depth="2"] .tree-table__indent {
    text-indent: 0.5rem;
  }
  tr[data-depth="3"] .tree-table__indent {
    text-indent: 1rem;
  }
  tr[data-depth="4"] .tree-table__indent {
    text-indent: 1.5rem;
  }
  tr[data-depth="5"] .tree-table__indent {
    text-indent: 2rem;
  }
</style>
