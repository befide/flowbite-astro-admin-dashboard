---
import fastCartesian from "fast-cartesian";
import MemberIcon from "./MemberIcon.astro";
import {
  careerLevels,
  disciplinaryProfessions,
  genders,
  Organization,
} from "@lib/domain";
import { flattenTreeNodes, getRoots, type TreeNode } from "@lib/content.tree";

import type { OrganizationSchema } from "@lib/common.d.ts";

import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getValue } from "../../../lib/content";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  organization: Organization;
}
let { organization } = Astro.props;

const product = fastCartesian([
  [...careerLevels],
  [...disciplinaryProfessions],
  [...genders],
]);

const organisations = (await organization.getOrganizationList()).map(
  (d: any) => ({
    ...d,
    parent__id: d.parent__id === "community" ? null : d.parent__id,
  }),
);
let roots: TreeNode<OrganizationSchema>[] =
  getRoots<OrganizationSchema>(organisations);

const list = flattenTreeNodes(roots);
---

<section>
  <table class="not-format table">
    <thead>
      <tr>
        <th class="name">Name</th>
        <th class="members">members</th>
        <!--<th>total</th>-->
        {
          careerLevels.map((d) => (
            <th class="number">
              <span>{t(d)}</span>
              <MemberIcon careerLevel={d} />
            </th>
          ))
        }
        {
          disciplinaryProfessions.map((d) => (
            <th class="number">
              <span>{t(d)}</span>
              <MemberIcon disciplinaryProfession={d} />
            </th>
          ))
        }
        {
          genders.map((d) => (
            <th class="number">
              <span>{t(d)}</span>
              <MemberIcon gender={d} />
            </th>
          ))
        }
        <th class="number"><span>recursive sum</span></th>
      </tr>
    </thead>
    <tbody>
      {
        list.map((item) => (
          <tr
            data-depth={item.depth}
            data-child-index={item.childIndex}
            data-has-children={item.children.length > 0}
          >
            <th class="name tree-table__name tree-table__indent">
              {item.data.label.fullName.en}
            </th>
            <td class="members">
              {product
                .filter((p) =>
                  getValue(item.data.uniquePeopleCount, p.join(".")),
                )
                .map((p) =>
                  new Array(getValue(item.data.uniquePeopleCount, p.join(".")))
                    .fill(0)
                    .map(() => (
                      <MemberIcon
                        careerLevel={p[0]}
                        disciplinaryProfession={p[1]}
                        gender={p[2]}
                      />
                    )),
                )}
            </td>
            {careerLevels.map((d) => (
              <td class="number">
                {getValue(item.data.uniquePeopleCountRecursiveSum, d) || "-"}
              </td>
            ))}

            {disciplinaryProfessions.map((d) => (
              <td class="number">
                {getValue(item.data.uniquePeopleCountRecursiveSum, d) || "-"}
              </td>
            ))}

            {genders.map((d) => (
              <td class="number">
                {getValue(item.data.uniquePeopleCountRecursiveSum, d) || "-"}
              </td>
            ))}
            {
              <td class="number">
                <strong>
                  {item.data.uniquePeopleCountRecursiveSum?.total}
                </strong>
              </td>
            }
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<style>
  thead {
  }
  thead tr:first-child th {
    position: relative;
  }
  thead tr:first-child th span {
    display: block;
    white-space: nowrap;

    line-height: 0.5rem;
    font-size: var(--text-2xs);
    transform-origin: bottom right;
    position: absolute;
    right: 0.6rem;
    bottom: 0.25rem;
    font-weight: 300;
    text-align: right;
    overflow: visible;
    transform: rotate(90deg);
  }
  thead th.number,
  td.number {
    width: 3ch;
  }

  th.members,
  td.members {
    width: 20%;
    text-align: right;
  }
  th.name,
  td.name {
    width: 60%;
    white-space: break-spaces;
    line-height: 0.6rem;
    padding-bottom: 0.25rem;
  }
  @media print {
    .members {
    }
  }

  tr[data-depth="1"] .tree-table__indent {
    padding-left: 0.5rem;
  }
  tr[data-depth="2"] .tree-table__indent {
    padding-left: 0.75rem;
  }
  tr[data-depth="3"] .tree-table__indent {
    padding-left: 1rem;
  }
  tr[data-depth="4"] .tree-table__indent {
    padding-left: 1.25rem;
  }
  tr[data-depth="5"] .tree-table__indent {
    padding-left: 1.5rem;
  }
  tr[data-depth="6"] .tree-table__indent {
    padding-left: 1.75rem;
  }
  td {
    white-space: normal;
  }
</style>
