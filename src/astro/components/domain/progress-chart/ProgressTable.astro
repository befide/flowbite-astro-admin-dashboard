---
import { JSDOM } from "jsdom";
import { axisBottom, axisLeft, axisRight } from "d3";

import { format, formatLocale } from "d3";
import { scaleLinear, scaleLog } from "d3";
import { select } from "d3";

import { curveCardinal, line } from "d3";

import chartMetas from "./ProgressChart.config";
import type { Fragment } from "astro/jsx-runtime";

export interface ProgressChart {
  baselineHeight?: number;
  widthInGridUnits?: number;
  heightInGridUnits?: number;
  dimension?: string;
}

export type Data = Datum[];

export interface Datum {
  year: number;
  value: number;
  value_sum?: number;
}

const { dimension = "nuclideDiscoveriesPerYear" } = Astro.props;

const data = chartMetas[dimension];

if (!data) throw new Error("undefined dimension: " + dimension);

const columns = Object.keys(data.data[0]);
---

<table class="grid-table not-format">
  <thead>
    <tr>
      {columns.map((column) => <th>{column}</th>)}
    </tr>
  </thead>
  <tbody>
    {
      data.data.map((d) => (
        <tr>
          {columns.map((key) =>
            typeof d[key] === "string" && d[key].startsWith("http") ? (
              <td class="url">
                <a
                  class="truncate text-slate-400 hover:text-teal-400"
                  href={d.source}
                  target="_blank"
                >
                  {d.source}
                </a>
              </td>
            ) : (
              <td>{d[key]}</td>
            ),
          )}
        </tr>
      ))
    }
  </tbody>

  <caption class="md">
    <slot />
  </caption>
</table>

<style>
  .truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: block;
  }
  .grid-table {
    grid-template-columns: 1fr 1fr 1fr 1fr 4fr;
  }
  td.url {
    white-space: nobreak;
    word-break: break-all;
  }
</style>
