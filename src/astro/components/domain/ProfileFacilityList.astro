---
import { getEntry } from "astro:content";
import type { FacilitySchema } from "../../../lib/common";
import {
  getReferenceLocalizedValue,
  getTaxonomyReferencesTerm,
  getTaxonomyReferenceTerm,
} from "../../../lib/content";
import { getFacilityRoots } from "../../../lib/domain";
import { flattenTreeNodes } from "../../../lib/content.tree";
import Badge from "../ui/Badge.astro";

interface Props {
  facilities: FacilitySchema[];
}
let { facilities } = Astro.props;

const locale = Astro.currentLocale || "de";
const facilityRoots = getFacilityRoots(facilities);
const list = facilities; //flattenTreeNodes(facilityRoots)
---

<ol class="">
  {
    list.map(async (facility) => (
      <li>
        <div class="name">{facility.label.en}</div>
        <table class="property-table not-format">
          <tbody>
            <tr>
              <th>Type</th>
              <th>en</th>
              <td>
                {await getTaxonomyReferenceTerm(
                  facility.instanceOf__taxonomyId,
                  "en",
                )}
              </td>
            </tr>
            <tr>
              <th />
              <th>de</th>
              <td>
                {await getTaxonomyReferenceTerm(
                  facility.instanceOf__taxonomyId,
                  "de",
                )}
              </td>
            </tr>
            <tr>
              <th>current life cycle</th>
              <th>en</th>
              <td>
                {await getTaxonomyReferenceTerm(
                  facility.lifeCycle.currentStatus__taxonomyId,
                  "en",
                )}
              </td>
            </tr>

            <tr>
              <th>label</th>
              <th>en</th>
              <td>{facility.label.en}</td>
            </tr>
            <tr>
              <th />
              <th>de</th>
              <td>{facility.label.de}</td>
            </tr>
            <tr>
              <th>tagline</th>
              <th>en</th>
              <td>{facility.tagLine.en}</td>
            </tr>
            <tr>
              <th />
              <th>de</th>
              <td>{facility.tagLine.de}</td>
            </tr>
            <tr>
              <th>description</th>
              <th>en</th>
              <td>{facility.definition.en}</td>
            </tr>
            <tr>
              <th />
              <th>de</th>
              <td>{facility.definition.de}</td>
            </tr>
            {false && (
              <>
                <td>
                  <div class="nowrap">
                    {facility.parameters.primaryBeamParticles?.map(
                      (entry: string) => (
                        <Badge size="small" text={entry} />
                      ),
                    )}
                  </div>
                </td>
                <td>
                  <div class="">
                    {(
                      await getTaxonomyReferencesTerm(
                        facility.primaryApplications__taxonomyId,
                        locale,
                      )
                    ).map(
                      (application) =>
                        application && (
                          <Badge size="small" text={application} />
                        ),
                    )}
                  </div>
                </td>
                <td>
                  <div class="nowrap">
                    {await getTaxonomyReferenceTerm(
                      facility.lifeCycle?.currentStatus__taxonomyId,
                      locale,
                    )}
                  </div>
                </td>
              </>
            )}
          </tbody>
        </table>
      </li>
    ))
  }
</ol>

<style>
  li {
  }
  li[data-depth="1"] {
    padding-left: 0.5rem;
  }
  li[data-depth="2"] {
    padding-left: 1rem;
  }
  li[data-depth="3"] {
    padding-left: 1.5rem;
  }
  li[data-depth="4"] {
    padding-left: 4rem;
  }
</style>
