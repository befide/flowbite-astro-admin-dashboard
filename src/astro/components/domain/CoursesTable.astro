---
import { getCourses } from "@/astro/domain/courses/courses"
import { getEntry } from "astro:content"
import type { CollectionEntry } from "astro:content"
import Badge from "../Badge.astro"
import { getLocalizedValue } from "@/astro/domain/content"

interface Props {
  universityId?: string
}

let { universityId } = Astro.props

const isBachelorCourse = (course: CollectionEntry<"courses">) =>
  course.data.studyLevels__taxonomyId?.find((d) => d.indexOf("bachelor") > -1)
const isMasterCourse = (course: CollectionEntry<"courses">) =>
  course.data.studyLevels__taxonomyId?.find((d) => d.indexOf("master") > -1)

const university =
  universityId && (await getEntry("organizations", universityId))
const universityLabel = university && university.data.label.short.en

const courses = await getCourses(universityId)
const masterCourses = courses.filter(isMasterCourse)
const bachelorCourses = courses.filter(isBachelorCourse)
const getUniversity = async (course: CollectionEntry<"courses">) => {
  if (!course.data.university__organizationsId) return null
  const university = await getEntry(
    "organizations",
    course.data.university__organizationsId
  )
  return university
}
---

<section>
  <p>
    Per academic year, {universityLabel} offers {courses.length} courses related
    to accelerator research of which
    {!bachelorCourses.length && <span>all addresses bachelor students.</span>}
    anf
    {!masterCourses.length && <span>all addresses master students.</span>}
  </p>
  <table id="dc-table-graph">
    <thead>
      <tr class="table-header">
        {!universityId && <th>university</th>}
        <th>programme</th>
        <th>semester</th>
        <th>language</th>
        <th>title</th>
        <th>sws</th>
      </tr>
    </thead>
    <tbody>
      {
        courses.map(async (course) => (
          <tr>
            {!universityId && (
              <td class="nowrap">
                {(await getUniversity(course))?.data.label.short.en}
              </td>
            )}
            <td>{course.data.semesters}</td>
            <td>{course.data.languages}</td>
            <td>
              {course.data.teachingEvent__taxonomyId &&
                (
                  await getEntry(
                    "taxonomyItems",
                    course.data.teachingEvent__taxonomyId
                  )
                )?.data.term.en}
            </td>
            <td>
              {" "}
              <div class="course__badges">
                {isBachelorCourse(course) && (
                  <Badge
                    alt="Bachelor Program"
                    prefix=""
                    text="Bachelor"
                    size="small"
                  />
                )}
                {isMasterCourse(course) && (
                  <Badge
                    alt="Bachelor Program"
                    prefix=""
                    text="Master"
                    size="small"
                  />
                )}
              </div>
            </td>
            <td>
              <span class="course__title">
                {getLocalizedValue(course.data.title, Astro.locale)}
              </span>
            </td>
            <td>{course.data.weeklySemesterHours}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</section>
