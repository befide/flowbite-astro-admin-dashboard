---
import { flattenTreeNodes } from "@lib/content.tree"
import { getFacilityRoots } from "@lib/domain"
import type { Facility } from "@/lib/domain/facilities/facility"
import {getEntry} from "astro:content"
import type { FacilitySchema, OrganizationSchema } from "../../../lib/common"
import { getRoots } from "../../../lib/content.tree"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

interface Props {
  facilities: FacilitySchema[]
}
let {facilities} = Astro.props

const roots = getRoots<OrganizationSchema>(facilities)



const facilityRoots = getFacilityRoots (facilities)
const list = flattenTreeNodes (facilityRoots)

---

<table class="tree-table">
    <thead>
    <tr>
        <th>name</th>
        <th>particles</th>
        <th>application</th>
        <th>life cycle</th>
    </tr>
    </thead>
    <tbody>
    {
      list.map ((item) => (
              <tr
                      data-depth={item.depth}
                      data-child-index={item.childIndex}
                      data-has-children={item.children.length > 0}
              >
                  <td class="tree-table__name tree-table__indent">
                    {(item.children.length > 0) &&
                            <input
                                    id={"collapsible-" + item.depth + "-" + item.childIndex}
                                    class="toggle"
                                    checked="checked"
                                    type="checkbox"
                            />
                            <label
                                    for={"collapsible-" + item.depth + "-" + item.childIndex}
                                    class="lbl-toggle"
                            >

                              <span class="name">{item.data.label?.en}</span>
                            </label>

                    }
