---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import _data from './research-agenda.json'
import type { ResearchAgenda } from './research-agenda'

let data: ResearchAgenda = Object.values(_data)

export interface Props {
  filter: string
}

const { filter } = Astro.props

const item = data.find((item) => item.path === filter)
---

<figure class="facility">
  <div class="container">
    <object
      data={'/svg/research-agenda/' + filter + '.svg'}
      type="image/svg+xml"></object>
  </div>
  <figcaption>
    <p class="md">
      <strong>{item?.label}: </strong>{item?.description}
    </p>
  </figcaption>
</figure>

<style>
  figure {
    display: flex;
    flex-direction: column;
    width: 11rem;
    height: 27rem;
    position: relative;
  }

  .container {
    flex: 0 0 12rem;
    position: relative;
  }
  object {
    position: absolute;
    width: 19rem;
    height: 19rem;
    top: -4rem;
    left: -5rem;
  }

  figcaption {
    flex: 1;
  }
</style>
