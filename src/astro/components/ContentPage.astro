---
import { render, type CollectionEntry } from "astro:content";

type Props = {
  section: CollectionEntry<"sections">;
};

const { section } = Astro.props;

const { Content } = await render(section);

const Element = "h" + (section.data.sectionDepth + 1);
---

<section class="section bg-white dark:bg-gray-900">
  <header>
    <Element
      class="tracking-tight text-gray-900 dark:text-white"
      data-section-number={section.data.sectionNumber}
    >
      {section.data.title}
    </Element>
    <p class="description">{section.data.description}</p>
  </header>
  <div class="format">
    <Content />
  </div>
</section>

<style is:global>
  .section {
    padding-left: 3rem;
    page-break-before: always;
  }
  h1,
  h2,
  h3,
  h4,
  h5 {
    position: relative;
  }
  h1[data-section-number]::before,
  h2[data-section-number]::before,
  h3[data-section-number]::before,
  h4[data-section-number]::before {
    content: attr(data-section-number);
    /* font-size: var(--text-base); */
    display: block;
    width: 3rem;
    left: -3rem;
    text-align: right;
    position: absolute;
    font-weight: normal;
    /* transform: rotate(-90deg) translateX(-4ch) translateY(-2ch) ;
    transform-origin: 0 0; */
  }
</style>
