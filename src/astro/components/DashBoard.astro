---
import { allCommunityGroups, allCommunityTopLevelOrganizations } from "@domain/organizations"
import KnowledgeMap from "./domain/KnowledgeMap.astro"
import { getTestFacilities, getUserFacilities } from "@/lib/domain"

const formalOrganizations = await allCommunityTopLevelOrganizations()
const formalOrganizationsCount = formalOrganizations ? formalOrganizations.length : 0

const groups = await allCommunityGroups()
const groupsCount = groups ? groups.length : 0

const testFacilities = await getTestFacilities()
const testFacilitiesCount = testFacilities ? testFacilities.length : 0

const userFacilities = await getUserFacilities()
const userFacilitiesCount = userFacilities ? userFacilities.length : 0
---

<div class="px-4 pt-6">
  <div class="mt-4 flex w-full gap-4">
    <div class="flex-1 flex-col items-center gap-4">
      <div
        class="w-full flex-col rounded-lg border border-gray-200 bg-white shadow-sm sm:flex sm:p-6 dark:border-gray-700 dark:bg-gray-800"
      >
        <h3 class="text-lg font-normal text-gray-500 dark:text-gray-400">Formal Organization</h3>
        <p>
          <span class="text-2xl leading-none font-bold text-gray-900 sm:text-3xl dark:text-white"
            >{formalOrganizationsCount}</span
          > organizations
        </p>
      </div>
      <div
        class="w-full flex-col rounded-lg border border-gray-200 bg-white shadow-sm sm:flex sm:p-6 dark:border-gray-700 dark:bg-gray-800"
      >
        <h3 class="text-lg font-normal text-gray-500 dark:text-gray-400">Research / Work groups</h3>
        <p>
          <span class="text-2xl leading-none font-bold text-gray-900 sm:text-3xl dark:text-white"
            >{groupsCount}</span
          > groups
        </p>
      </div>
      <div
        class="w-full flex-col rounded-lg border border-gray-200 bg-white shadow-sm sm:flex sm:p-6 dark:border-gray-700 dark:bg-gray-800"
      >
        <h3 class="text-lg font-normal text-gray-500 dark:text-gray-400">Potential Members</h3>
        <p>
          <span class="text-2xl leading-none font-bold text-gray-900 sm:text-3xl dark:text-white"
            >950</span
          > people
        </p>
      </div>
    </div>
    <div
      class="flex-1 flex-col items-center justify-between gap-8 rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:flex sm:p-6 dark:border-gray-700 dark:bg-gray-800"
    >
      <KnowledgeMap />
    </div>
  </div>

  <div class="mt-4 flex gap-4">
    <div class="flex-1 flex-col items-center">
      <div
        class="flex-col rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:flex sm:p-6 dark:border-gray-700 dark:bg-gray-800"
      >
        <h3 class="text-lg font-normal text-gray-500 dark:text-gray-400">Test Facilities</h3>
        <p>
          <span class="text-2xl leading-none font-bold text-gray-900 sm:text-3xl dark:text-white"
            >{testFacilitiesCount}</span
