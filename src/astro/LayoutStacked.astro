---
import FooterStacked from "./FooterStacked.astro";
import LayoutCommon from "./LayoutCommon.astro";
import NavBarStacked from "./NavBarStacked.astro";
---

<LayoutCommon>
  <NavBarStacked />

  <div class="flex overflow-hidden pt-16">
    <div
      id="main-content"
      class="relative mx-auto h-full min-h-screen w-full max-w-screen-2xl overflow-y-auto"
    >
      <div class="px-4 pt-6 2xl:px-0">
        <slot />
      </div>

      <FooterStacked />
    </div>
  </div>
</LayoutCommon>
