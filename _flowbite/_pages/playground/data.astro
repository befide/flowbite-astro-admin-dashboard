---
/* http://localhost:2121/playground/data/ */

import Code from "astro/components/Code.astro"
import LayoutSidebar from "@astro/LayoutSidebar.astro"
import { getUsers, getProducts } from "../../services/index.js"

const products = JSON.stringify(getProducts(), null, 2)

const users = JSON.stringify(getUsers(), null, 2)
---

<LayoutSidebar class="bg-slate-800 text-slate-100">
  <div class="playground p-16">
    <h1 class="ml-8 text-3xl font-bold lg:text-4xl xl:text-6xl dark:text-slate-100">🕹&nbsp;Playground — API data</h1>

    <div class="mt-24 mb-8">
      <button
        type="button"
        class="mr-2 mb-2 rounded-full bg-blue-700 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 focus:outline-none dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
        onclick="location.reload()">Refresh</button
      >
    </div>

    <div class="mb-16">
      <a href="/api/products" target="_blank">
        <h1 class="mb-8 text-6xl font-bold dark:text-slate-100">Products</h1>
      </a>

      <Code code={products} lang="json" />
    </div>
    <div class="mb-16">
      <a href="/api/users" target="_blank">
        <h1 class="mb-8 text-6xl font-bold dark:text-slate-100">Users</h1>
      </a>

      <Code code={users} lang="json" />
    </div>
  </div>
</LayoutSidebar>

<style is:global>
  .playground .astro-code {
    @apply rounded-3xl p-8;
  }
</style>
