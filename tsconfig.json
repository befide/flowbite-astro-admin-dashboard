{
  "extends": "astro/tsconfigs/base",
  "include": [
    ".astro/types.d.ts",
    "src/env.d.ts",
    "src/**/*",
    "scripts/**/*",
    "astro.config.ts",
    "node_modules/**/*.d.ts"
  ],
  "compilerOptions": {
    "types": [
      "astro/client",
      "vite-plugin-pwa/vanillajs",
      "vite-plugin-pwa/info",
      "vite-plugin-pwa/info.d.ts",
      "vite-plugin-pwa/client.d.ts"
    ],
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"

      }
    ],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/astro/components/*"
      ],
      "@styles/*": [
        "./src/app/styles/*"
      ],
      "@utils/*": [
        "./src/astro/domain/*"
      ],
      "@layouts/*": [
        "./src/astro/layouts/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@content/*": [
        "./src/content/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@astro/*": [
        "./src/astro/*"
      ],
      "@domain/*": [
        "./src/lib/domain/*"
      ],
      "@nanostores/*": [
        "./src/lib/nanostores/*"
      ]
    }
  }
}
