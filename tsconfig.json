{
  "extends": "astro/tsconfigs/strict",
  "include": [
    "./astro.config.ts",
    "./src/**/*.ts",
    "./src/**/*.astro"
  ],
  "exclude": [
    "./scripts/download-grist.ts"
  ],
  "compilerOptions": {
    "types": [
      "astro/client",
      "vite-plugin-pwa/vanillajs",
      "vite-plugin-pwa/info"
    ],
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/astro/components/*"
      ],
      "@styles/*": [
        "./src/astro/styles/*"
      ],
      "@utils/*": [
        "./src/astro/domain/*"
      ],
      "@layouts/*": [
        "./src/astro/layouts/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@content/*": [
        "./src/content/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@astro/*": [
        "./src/astro/*"
      ],
      "@domain/*": [
        "./src/lib/domain/*"
      ],
      "@nanostores/*": [
        "./src/lib/nanostores/*"
      ]
    }
  }
}