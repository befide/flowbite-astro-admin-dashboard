{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"strictNullChecks": true,
		"baseUrl": "./",
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@components/*": [
				"./src/astro/components/*"
			],
			"@styles/*": [
				"./src/astro/styles/*"
			],
			"@utils/*": [
				"./src/astro/domain/*"
			],
			"@nanostore/*": [
				"./src/astro/nanostore/*"
			],
			"@layouts/*": [
				"./src/astro/layouts/*"
			],
			"@domain/*": [
				"./src/astro/domain/*"
			],
			"@content/*": [
				"./src/content/*"
			],
			"@assets/*": [
				"./src/content/assets/*"
			],
		}
	}
}
