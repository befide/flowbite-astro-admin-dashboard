{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/env.d.ts",
    "src/**/*",
    "scripts/**/*",
    "astro.config.ts",
    "node_modules/**/*.d.ts"
  ],
  "exclude": [
    "scripts",
    "_flowbite",
    "playwright-report",
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "types": [
      "astro/client",
      "vite-plugin-pwa/vanillajs",
      "vite-plugin-pwa/info",
      "vite-plugin-pwa/pwa-assets"
    ],
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "strictNullChecks": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/astro/components/*"
      ],
      "@styles/*": [
        "./src/app/styles/*"
      ],
      "@utils/*": [
        "./src/astro/domain/*"
      ],
      "@layouts/*": [
        "./src/astro/layouts/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@content/*": [
        "./src/content/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@astro/*": [
        "./src/astro/*"
      ],
      "@domain/*": [
        "./src/lib/domain/*"
      ],
      "@nanostores/*": [
        "./src/lib/nanostores/*"
      ]
    }
  }
}
